configuration {
    show-icons: true;
    /* Формат отображения: иконка и имя приложения (без лишнего текста) */
    drun-display-format: "{icon} {name}";
}

* {
    /* Точные цвета с вашего скриншота */
    bg:          #161923; /* Темный фон основного окна */
    bg-alt:      #212634; /* Чуть более светлый фон для строки поиска */
    txt:         #9fa6b4; /* Цвет обычного текста */
    txt-selected:#161923; /* Темный текст на оранжевом фоне */
    accent:      #cd7a64; /* Терракотово-оранжевый цвет выделения */

    font: "JetBrainsMono Nerd Font 14";
    background-color: transparent;
}

window {
    width:            20%;
    background-color: @bg;
    padding:          16px;
    border-radius:    24px; /* Мягкое крупное скругление окна */
    border:           0px;  /* Полностью убираем рамку вокруг окна */
}

mainbox {
    /* На скриншоте поиск находится в самом низу */
    children:         [ listview, inputbar ];
    background-color: @bg;
    spacing:          16px;
}

listview {
    lines:            4;
    background-color: @bg;
    spacing:          4px;
    scrollbar:        false; /* Отключаем скроллбар, как на скрине */
    fixed-height:     true;
    border:           0px;
    dash-style:       none;
}

element {
    /* Внутренние отступы, чтобы элемент был пухлым, как на скрине */
    padding:          8px 16px;
    background-color: @bg;
    border-radius:    16px; /* Закругленные углы у приложений */
    text-color:       @txt;
}

/* Элемент внутри списка: иконка и текст */
element-icon {
    size:             24px;
    margin:           0px 12px 0px 0px;
}

element-text {
    text-color:       inherit;
    vertical-align:   0.5;
}

/* Активное выделенное приложение */
element selected {
    background-color: @accent; /* Тот самый оранжевый ползунок */
    text-color:       @txt-selected; /* Текст становится темным */
}

inputbar {
    children:         [ entry ];
    background-color: @bg-alt;
    border-radius:    16px;
    /* Отступы внутри строки поиска для высоты */
    padding:          10px 16px;
}

entry {
    placeholder:      "Search..."; /* Подпись как на скриншоте */
    placeholder-color:#525867;
    horizontal-align: 0.5; /* Текст строго по центру */
    vertical-align:   0.5;
    text-color:       @txt;
}
